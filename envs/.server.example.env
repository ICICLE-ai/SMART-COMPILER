# Native server example. Copy to .env and replace the two absolute paths.
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
MCP_SERVER_TRANSPORT=sse
ENABLE_REST_API=true
CETUS=/absolute/path/to/The-Cetus-Project/bin/cetus
CETUS_PROFILES_FILE=/absolute/path/to/SMART-COMPILER/config/profiles.json
CETUS_TIMEOUT_SECONDS=300

# Optional: used only by tasks that request the Ollama profiler.
OLLAMA_MODEL=llama3.1:latest
OLLAMA_HOST=http://localhost:11434
