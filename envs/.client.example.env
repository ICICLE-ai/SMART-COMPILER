# Native client example. Copy to .env and replace the root with your checkout.
LOG_LEVEL=INFO
LLM_MODEL=llama3.1-smart-compiler:latest
LLM_HOST=http://localhost:11434
MCP_SERVER_URL=http://localhost:8000/sse
ALLOWED_PATHS=file:///absolute/path/to/SMART-COMPILER/Testing_Examples

# Optional OpenAI API configuration; keep the key in your shell or private .env.
# LLM_MODEL=gpt-6-astra
# LLM_HOST=https://api.openai.com/v1
# OPENAI_API_KEY=replace-with-your-key
