FROM python:3.12-slim-bookworm

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LOG_LEVEL=INFO \
    MCP_SERVER_URL=http://server:8000/sse \
    LLM_HOST=http://ollama:11434/v1 \
    LLM_MODEL=llama3.1-smart-compiler:latest \
    ALLOWED_PATHS=file:///app/Testing_Examples

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/client ./src/client
COPY src/shared ./src/shared
COPY src/run_client.py ./src/run_client.py
COPY Testing_Examples ./Testing_Examples

CMD ["python", "src/run_client.py"]
